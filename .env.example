# Instalacao local: servidor compartilhado com o Planner (bancos separados).
# Para instalacao independente com o perfil legacy, use a porta 5432.
DATABASE_URL=postgresql+psycopg://gym_tracker:gym_tracker@localhost:5434/gym_tracker
DATA_BACKEND=postgres
LEGACY_CSV_PATH=academia_treinos_whatsapp.csv
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
LLM_SHADOW_MODE=true
LLM_AUTO_ACCEPT=false
PARSER_VERSION=3.0.0

# Importacao automatica local (sem chamadas a IA).
# Se houver apenas um usuario, pode ficar vazio.
GYM_TRACKER_USER_ID=
GYM_IMPORT_FILE="whatsapp_acad_export/Conversa do WhatsApp com Acad.txt"
GYM_IMPORT_INTERVAL_SECONDS=60
GYM_IMPORT_SETTLE_SECONDS=10

# Backup obrigatorio antes de novos imports/reprocessamentos automaticos.
# O contêiner precisa publicar a mesma porta local de DATABASE_URL.
# No perfil legacy, use o nome real do conteiner postgres (confira docker ps).
GYM_BACKUP_CONTAINER=projeto-planejador-db-1
GYM_BACKUP_DIRECTORY=local_backups/automatic
